<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meetingd.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE_ME/.local/bin/meetingd</string>
    <string>run</string>
    <string>--interval</string>
    <string>1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/meetingd/events.ndjson</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/meetingd/meetingd.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
